# Copy to .env.local for development builds, or to .env.production.local for local production
# builds. Both files are gitignored. Variables set in the process environment take precedence.
#
# Source checkouts of the CLI, MCP server, desktop app and website read these files directly.
# Packaged apps bake CONVEX_URL and VECTIS_WEB_URL in at package time and ignore the environment.

# Convex. `pnpm exec convex dev` writes the first three for your development deployment.
CONVEX_DEPLOYMENT=dev:your-deployment-123
CONVEX_URL=https://your-deployment-123.convex.cloud
CONVEX_SITE_URL=https://your-deployment-123.convex.site

# Clerk. `clerk env pull` writes these for the selected instance. The secret key is only used by
# the Clerk CLI and never reaches a build.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# The HTTPS origin that serves the website and /connect for this deployment, without a path.
VECTIS_WEB_URL=https://vectis-dev.your-account.workers.dev

# Convex deployment variables. These are not read from this file: set them on the deployment
# with `pnpm exec convex env set <name> <value>` (add `--prod` for production).
#
#   CLERK_JWT_ISSUER_DOMAIN      Clerk Frontend API URL, for example https://your-app.clerk.accounts.dev
#   VECTIS_MACHINE_ISSUER        The deployment's .convex.site URL; issues machine tokens
#   VECTIS_MACHINE_PRIVATE_KEY   RS256 PKCS#8 PEM used to sign machine tokens
#   VECTIS_WEB_URL               Same value as above; used for GitHub callbacks and redirects
#   VECTIS_GITHUB_APP_NAME       GitHub App name, for example "Vectis [DEV]"
#   VECTIS_GITHUB_APP_PUBLIC     "false" keeps the GitHub App installable only by its owner
