# Copy to .env.local for development builds, or to .env.production.local for local production
# builds. Both files are gitignored. Variables set in the process environment take precedence.
#
# Source checkouts of the CLI, MCP server, desktop app and website read these files directly.
# Packaged apps bake VECTIS_CLOUD_URL and VECTIS_WEB_URL in at package time and ignore the
# environment.

# The cloud Worker (apps/cloud). Development builds may use the local `pnpm --filter
# @vectis/cloud dev` origin, http://127.0.0.1:8787; production builds require HTTPS.
VECTIS_CLOUD_URL=https://cloud-dev.example.com

# Clerk. `clerk env pull` writes these for the selected instance. The secret key is only used by
# the Clerk CLI and never reaches a build.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# The HTTPS origin that serves the website and /connect for this deployment, without a path.
VECTIS_WEB_URL=https://dev.example.com

# Cloud Worker settings are not read from this file. Plain values live in the `vars` of
# apps/cloud/wrangler.jsonc for each environment; the secret is set with
# `pnpm --filter @vectis/cloud exec wrangler secret put CLERK_WEBHOOK_SECRET --env <env>`
# (locally in apps/cloud/.dev.vars).
#
#   VECTIS_WEB_URL               Same value as above; CORS origin, GitHub callbacks and redirects
#   VECTIS_CLOUD_URL             The Worker's own origin; GitHub webhook and manifest URLs
#   CLERK_ISSUER                 Clerk Frontend API URL, for example https://your-app.clerk.accounts.dev
#   VECTIS_GITHUB_APP_NAME       GitHub App name, for example "Vectis [DEV]"
#   VECTIS_GITHUB_APP_PUBLIC     "false" keeps the GitHub App installable only by its owner
#   CLERK_WEBHOOK_SECRET         Secret: signing secret of the Clerk user.deleted webhook (whsec_...)
