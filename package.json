{
  "name": "vectis-workspace",
  "version": "0.1.1",
  "private": true,
  "homepage": "https://vectis.kerd.dev",
  "bugs": "https://github.com/kerddotdev/vectis/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerddotdev/vectis.git"
  },
  "files": [
    "dist/apps/cli/src",
    "dist/apps/server/src",
    "dist/apps/mcp/src",
    "dist/apps/desktop/src",
    "dist/packages",
    "dist/convex/_generated/api.js",
    "apps/desktop/renderer",
    "apps/desktop/preload.cjs",
    "skills/vectis",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && pnpm --filter @vectis/web exec tsc --noEmit && pnpm --filter @vectis/web exec tsc -p tsconfig.worker.json --noEmit && pnpm --filter @vectis/desktop exec tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings apps packages scripts convex tests",
    "vectis": "node dist/apps/cli/src/main.js",
    "proof:linux": "node dist/scripts/prove-linux.js",
    "mcp": "node dist/apps/mcp/src/main.js",
    "docs:dev": "pnpm build && pnpm --filter @vectis/docs dev",
    "site:build": "pnpm build && pnpm --filter @vectis/web build && pnpm --filter @vectis/docs build && node dist/scripts/stage-site.js",
    "site:deploy:dev": "VECTIS_FLAVOR=development pnpm site:build && VECTIS_FLAVOR=development node dist/scripts/deploy-site.js development",
    "site:deploy": "VECTIS_FLAVOR=production pnpm site:build && VECTIS_FLAVOR=production node dist/scripts/deploy-site.js production",
    "web:dev": "pnpm --filter @vectis/web dev",
    "desktop:build": "pnpm build && pnpm --filter @vectis/desktop build",
    "desktop:start": "pnpm --filter @vectis/desktop start",
    "package:cli": "pnpm desktop:build && node dist/scripts/package-cli.js",
    "package:verify": "pnpm build && node dist/scripts/verify-package.js",
    "package:desktop": "pnpm build && node dist/scripts/package-desktop.js",
    "package:headless": "pnpm build && node dist/scripts/package-headless.js",
    "package:windows-runtime": "pnpm build && node dist/scripts/package-windows-runtime.js",
    "package:runtime-sources": "pnpm build && node dist/scripts/collect-runtime-sources.js",
    "package:release": "pnpm build && node dist/scripts/package-release.js",
    "package:verify-runtime-sources": "pnpm build && node dist/scripts/verify-runtime-sources.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "convex": "1.46.0",
    "effect": "4.0.0-rc.117",
    "electron-updater": "6.8.9",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@electron/packager": "20.3.0",
    "@types/node": "24.13.4",
    "convex-test": "0.0.60",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.24.0"
}
