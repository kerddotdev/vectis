{
  "name": "vectis-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings apps packages scripts",
    "vectis": "node dist/apps/cli/src/main.js",
    "proof:linux": "node dist/scripts/prove-linux.js"
  },
  "dependencies": {
    "convex": "1.45.0",
    "effect": "4.0.0-rc.115",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.24.0"
}
