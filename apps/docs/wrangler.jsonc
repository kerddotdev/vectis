{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vectis-docs",
  "compatibility_date": "2026-09-15",
  "env": {
    "development": {
      "name": "vectis-docs-dev",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
      },
    },
  },
}
