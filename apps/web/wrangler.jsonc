{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vectis-web",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  // VECTIS_CONVEX_SITE is passed by scripts/deploy-site.ts from CONVEX_SITE_URL.
  "env": {
    "development": {
      "name": "vectis-dev",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
      },
    },
    "production": {
      "name": "vectis-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "vectis.kerd.dev", "custom_domain": true }],
      "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
      },
    },
  },
}
