{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vectis-web",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  // CLOUD reaches the cloud Worker (apps/cloud) of the same flavor for the proxied /api routes.
  "env": {
    "development": {
      "name": "vectis-dev",
      "workers_dev": true,
      "services": [{ "binding": "CLOUD", "service": "vectis-cloud-dev" }],
      "preview_urls": false,
      "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
      },
    },
    "production": {
      "name": "vectis-web",
      "workers_dev": false,
      "services": [{ "binding": "CLOUD", "service": "vectis-cloud" }],
      "preview_urls": false,
      "routes": [{ "pattern": "vectis.kerd.dev", "custom_domain": true }],
      "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
      },
    },
  },
}
