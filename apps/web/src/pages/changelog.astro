---
import { site } from "@vectis/design/site";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { releases } from "../lib/releases";

const entries = await releases();
const format = new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" });
---

<Base
  image="/og/changelog.png"
  title="Changelog"
  description="What changed in each Vectis release."
  current="/changelog"
>
  <PageHero title="Changelog">
    <p>What changed in each release of the Vectis app, CLI and service.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="button button-primary" href={site.download}>Download the latest release</a>
      <a class="button button-secondary" href={`${site.repository}/releases`}>All releases on GitHub</a>
    </div>
  </PageHero>
  <div class="shell flex flex-col pb-28">
    {
      entries.length === 0 ? (
        <p class="border-t border-hairline py-14 text-muted">No releases are published yet.</p>
      ) : (
        entries.map((release) => (
          <article
            id={`v${release.version}`}
            class="grid grid-cols-1 gap-6 border-t border-hairline py-14 lg:grid-cols-[14rem_1fr] lg:gap-16"
          >
            <header class="flex flex-col gap-1.5">
              <a class="font-mono text-[15px]" href={`#v${release.version}`}>
                {release.version}
              </a>
              <time class="eyebrow" datetime={release.date.toISOString().slice(0, 10)}>
                {format.format(release.date)}
              </time>
              {release.prerelease && <span class="eyebrow">Prerelease</span>}
            </header>
            <div class="release flex max-w-[64ch] flex-col gap-5">
              <h2 class="text-2xl font-medium">{release.title}</h2>
              <Fragment set:html={release.html} />
              <a class="prose-link self-start" href={release.url}>
                Release on GitHub
              </a>
            </div>
          </article>
        ))
      )
    }
  </div>
</Base>

<style>
  .release :global(p),
  .release :global(li) {
    color: var(--vectis-muted);
  }
  .release :global(h2),
  .release :global(h3) {
    color: var(--vectis-foreground);
    font-weight: 500;
  }
  .release :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .release :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 1.1em;
    list-style: disc;
  }
  .release :global(li::marker) {
    color: var(--vectis-brand);
  }
</style>
