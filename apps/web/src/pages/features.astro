---
import environmentsDark from "../assets/app/environments-dark.png";
import environmentsLight from "../assets/app/environments-light.png";
import repositoriesDark from "../assets/app/repositories-dark.png";
import repositoriesLight from "../assets/app/repositories-light.png";
import AppWindow from "../components/AppWindow.astro";
import Feature from "../components/Feature.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { codeLines } from "../lib/code";

const sections = [
  ["runners", "Disposable runners"],
  ["guests", "Guest images"],
  ["automatic", "Automatic runners"],
  ["logs", "Job logs"],
  ["readiness", "Readiness"],
  ["access", "Access control"],
  ["control", "Run control"],
  ["agents", "Agents and automation"],
  ["migration", "Workflow migration"],
  ["remote", "Remote control"],
  ["app", "The Mac app"],
];
const prepare = `<span class="p">$</span> vectis environment prepare-linux ubuntu-24-arm64 \\
    <span class="k">--image-directory</span> /Volumes/Runner/images \\
    <span class="k">--storage-path</span> /Volumes/Runner/vms \\
    <span class="k">--cpu</span> 4 <span class="k">--memory-mib</span> 8192 <span class="k">--disk-gib</span> 32 <span class="k">--json</span>
<span class="p">$</span> vectis operation wait op_52aa <span class="k">--timeout</span> 3600000 <span class="k">--json</span>`;
const mcpTools = [
  "vectis_status",
  "vectis_capabilities",
  "vectis_command",
  "vectis_wait",
  "vectis_operation",
  "vectis_activities",
  "vectis_activity",
  "vectis_logs",
  "vectis_job_logs",
  "vectis_jobs",
  "vectis_repositories",
  "vectis_readiness",
  "vectis_storage",
  "vectis_doctor",
  "vectis_github_accounts",
  "vectis_github_connect",
  "vectis_service",
  "vectis_cloud",
  "vectis_machines",
];
const jobLogs = `<span class="p">$</span> vectis job logs 9482105 <span class="k">--binding</span> bind_app <span class="k">--follow</span>
<span class="dim">2026-10-14T09:12:03Z Run pnpm test</span>
<span class="dim">2026-10-14T09:12:09Z Tests  128 passed (128)</span>`;
const readiness = `<span class="p">$</span> vectis repository readiness acme/app <span class="k">--json</span>
<span class="dim">{"ready":</span> false<span class="dim">, "checks": [</span>
<span class="dim">  {"id":</span> <span class="k">"admin_rights"</span><span class="dim">, "status":</span> <span class="k">"ok"</span><span class="dim">, ...},</span>
<span class="dim">  {"id":</span> <span class="k">"fork_approval"</span><span class="dim">, "status":</span> <span class="k">"blocked"</span><span class="dim">, "code": ..., "nextStep": ...}]}</span>`;
const control = `<span class="p">$</span> vectis run rerun-failed bind_app 77123 <span class="k">--wait --json</span>
<span class="p">$</span> vectis run cancel bind_app 77123 <span class="k">--wait --json</span>
<span class="p">$</span> vectis workflow dispatch bind_app test.yml <span class="k">--ref</span> main <span class="k">--wait --json</span>`;
const access = `<span class="p">$</span> vectis repository access bind_app <span class="k">--actors</span> 1024,2048 <span class="k">--approval</span> required <span class="k">--wait --json</span>`;
const remote = `<span class="p">$</span> vectis login
<span class="p">$</span> vectis machine list <span class="k">--json</span>
<span class="p">$</span> vectis status <span class="k">--machine</span> studio <span class="k">--json</span>
<span class="p">$</span> vectis runner run bind_app <span class="k">--machine</span> studio <span class="k">--json</span>`;
const migration = `<span class="p">$</span> vectis migration preview .github/workflows/test.yml \\
    <span class="k">--map</span> ubuntu-24.04-arm=vectis-ubuntu <span class="k">--wait --json</span>
<span class="dim">{"status":</span> <span class="k">"succeeded"</span><span class="dim">, "result": {"changed":</span> true<span class="dim">, "findings": [], ...}}</span>

<span class="p">$</span> vectis migration analyze bind_app <span class="k">--wait --json</span>
<span class="p">$</span> vectis migration publish prev_19c3 <span class="k">--wait --json</span>`;
---

<Base
  image="/og/features.png"
  title="Features"
  description="Disposable GitHub Actions runners, guest images, automatic runners, agent tooling, workflow migration and remote control."
  current="/features"
>
  <PageHero title="Everything a runner needs, and nothing it keeps.">
    <p>
      Vectis turns an Apple Silicon Mac into a pool of clean, single-use GitHub Actions runners.
      Here is what it does, and where it deliberately stops.
    </p>
  </PageHero>

  <div class="shell grid grid-cols-1 gap-12 pb-24 lg:grid-cols-[11rem_1fr] lg:gap-16">
    <nav aria-label="On this page" class="hidden lg:block">
      <ol class="sticky top-28 flex flex-col border-l border-hairline text-[14.5px]" data-toc>
        {
          sections.map(([id, label]) => (
            <li>
              <a
                class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-muted transition-colors duration-200 hover:text-foreground aria-[current=true]:border-brand aria-[current=true]:text-foreground"
                href={`#${id}`}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="min-w-0">
      <Feature id="runners" title="One job, one machine, then gone.">
        <p>
          Every job runs in its own virtual machine, cloned from the environment you prepared. The
          official GitHub Actions runner registers just in time with a single-use configuration and
          takes exactly one job. A runner whose job no longer needs capacity is stopped after 10 idle
          minutes.
        </p>
        <p>
          Afterwards Vectis stops and deletes the VM and removes the runner registration. It only
          reports success after it has seen the runner exit and the cleanup finish. If it cannot
          prove that, the operation stops at action required instead of guessing.
        </p>
        <AppWindow
          slot="artifact"
          light={environmentsLight}
          dark={environmentsDark}
          alt="The Environments view listing macOS 26, Ubuntu 24.04 and Windows 11 guest images."
        />
      </Feature>

      <Feature id="guests" title="Prepare a guest once.">
        <p>
          Vectis downloads macOS 26 from Apple and Ubuntu 24.04 from Canonical and checks each image
          against a pinned SHA-256 before using it. Windows 11 support is experimental: it installs
          from your own ISO, drivers, firmware and license, with a software TPM, and needs QEMU
          installed separately.
        </p>
        <p>
          Linux environments can optionally run x86_64 tools through Rosetta, including x86_64
          binaries and linux/amd64 containers. The runner itself stays ARM64.
        </p>
        <p>
          You decide the CPU, memory and disk for each environment, and where images and VM disks
          live, external drives included. Vectis keeps a quarter of your memory free for macOS.
        </p>
        <pre slot="artifact" class="code" data-reveal><code set:html={codeLines(prepare)} /></pre>
      </Feature>

      <Feature id="automatic" title="Runners that start themselves.">
        <p>
          Turn on automatic runners for a repository and Vectis watches for queued jobs that ask
          for your labels. An idle, unpaused Mac picks up the demand on its next heartbeat and
          starts one runner at a time.
        </p>
        <p>
          It never retries a failed or cancelled job on its own, and it is off until you enable it
          for each repository.
        </p>
        <AppWindow
          slot="artifact"
          light={repositoriesLight}
          dark={repositoriesDark}
          alt="The Repositories view with automatic runners enabled for one repository."
        />
      </Feature>

      <Feature id="logs" title="Read a job's log from anywhere.">
        <p>
          Read the log of a GitHub job from the app, with <code>vectis job logs</code>, or through
          the MCP tool <code>vectis_job_logs</code>. Follow a running job from the terminal, or let
          an agent page through the log with a cursor.
        </p>
        <p>
          Vectis keeps the last 4 MiB of each log and preserves GitHub's secret masking.
        </p>
        <pre slot="artifact" class="code" data-reveal><code set:html={codeLines(jobLogs)} /></pre>
      </Feature>

      <Feature id="readiness" title="Know what is missing before you connect.">
        <p>
          A readiness check lists each prerequisite for a repository: your cloud connection, GitHub
          account, App installation, admin rights, fork approval policy and environment. Every
          check has a status, a code and the next step.
        </p>
        <p>
          It is available in the connect dialog, as <code>vectis repository readiness</code> and as
          <code>vectis_readiness</code>. <code>vectis doctor</code> reports the runtime components
          of your Mac the same way.
        </p>
        <pre slot="artifact" class="code" data-reveal><code set:html={codeLines(readiness)} /></pre>
      </Feature>

      <Feature id="access" title="Decide who can use this Mac.">
        <p>
          For each repository connection, limit which GitHub users, by numeric ID, can start
          runners, and optionally require your approval of each job before it runs.
        </p>
        <p>
          Once GitHub assigns a job, a job-started hook inside the VM checks it again and stops the
          runner if it does not match.
        </p>
        <pre slot="artifact" class="code" data-reveal><code set:html={codeLines(access)} /></pre>
      </Feature>

      <Feature id="control" title="Rerun, cancel and dispatch.">
        <p>
          Rerun failed jobs, cancel a run, or dispatch a workflow from the app, the CLI or MCP. If
          GitHub's answer is ambiguous, Vectis reports that the run needs attention instead of
          retrying it.
        </p>
        <p>
          This needs you to approve the GitHub App's updated Actions permission.
        </p>
        <pre slot="artifact" class="code" data-reveal><code set:html={codeLines(control)} /></pre>
      </Feature>

      <Feature id="agents" title="Built for agents, not bolted on.">
        <p>
          The app, the CLI and the MCP server use one typed client, so agents get the same controls
          you do. Every CLI command answers in JSON, errors carry a stable code and a next step,
          and an operation that needs a person exits with code 3 instead of pretending to succeed.
        </p>
        <p>
          A portable agent skill explains the safe way to drive Vectis, and every documentation page
          is also available as Markdown through <a class="prose-link" href="/llms.txt">llms.txt</a>.
        </p>
        <div slot="artifact" class="flex flex-col gap-3">
          <p class="eyebrow">MCP tools</p>
          <ul class="grid grid-cols-1 gap-x-6 gap-y-2 font-mono text-[13.5px] sm:grid-cols-2">
            {mcpTools.map((tool) => <li class="border-b border-hairline pb-2">{tool}</li>)}
          </ul>
        </div>
      </Feature>

      <Feature id="migration" title="A pull request, not a rewrite.">
        <p>
          Vectis reads your workflow files and changes only the jobs it knows can run on ARM64. It
          leaves x64 jobs, reusable workflows, dynamic matrices and privileged triggers alone and
          tells you why.
        </p>
        <p>
          Publishing opens an ordinary pull request after one job has succeeded on your runners.
          Review it like any other change. Vectis never merges it.
        </p>
        <pre slot="artifact" class="code" data-reveal><code set:html={codeLines(migration)} /></pre>
      </Feature>

      <Feature id="remote" title="Control any of your Macs from any other.">
        <p>
          Sign in once and the app, the CLI and agents can control every Mac on your account.
          Commands queue in the Vectis cloud and each Mac collects them over an outbound
          connection, so no machine needs an open port.
        </p>
        <p>
          A remote command never falls back to running locally. Signed-in controllers expire after
          90 days and you can revoke them at any time.
        </p>
        <pre slot="artifact" class="code" data-reveal><code set:html={codeLines(remote)} /></pre>
      </Feature>

      <Feature id="app" title="A Mac app that tells the truth.">
        <p>
          The Vectis app shows what the local service actually reports: running, waiting for you,
          unsupported on this Mac, or done. Close the window and the service keeps running your jobs
          in the background. It sends a native notification when Vectis needs you or work fails.
        </p>
        <p>
          Prefer the terminal? Everything in the app is also in the CLI, with the same names and
          the same results.
        </p>
        <div slot="artifact" class="flex flex-wrap gap-2">
          {
            [
              ["Accepted", "text-neutral bg-neutral/10"],
              ["Running", "text-running bg-running/10"],
              ["Action required", "text-attention bg-attention/10"],
              ["Succeeded", "text-success bg-success/10"],
              ["Failed", "text-danger bg-danger/10"],
              ["Cancelled", "text-neutral bg-neutral/10"],
            ].map(([label, tone]) => (
              <span class:list={["rounded-full px-3 py-1.5 text-[14px] font-medium", tone]}>
                {label}
              </span>
            ))
          }
        </div>
      </Feature>
    </div>
  </div>
</Base>

<script is:inline>
  (() => {
    const links = [...document.querySelectorAll("[data-toc] a")];
    const sections = links.map((link) => document.querySelector(link.hash));
    let frame = 0;
    const update = () => {
      frame = 0;
      const line = innerHeight * 0.35;
      let active = 0;
      sections.forEach((section, index) => {
        if (section && section.getBoundingClientRect().top <= line) active = index;
      });
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4)
        active = sections.length - 1;
      links.forEach((link, index) => link.setAttribute("aria-current", String(index === active)));
    };
    addEventListener("scroll", () => (frame ||= requestAnimationFrame(update)), { passive: true });
    addEventListener("resize", update);
    update();
  })();
</script>
