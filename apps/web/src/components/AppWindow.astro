---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
}
const { light, dark, alt, eager = false, class: className } = Astro.props;
const sizes = "(min-width: 1200px) 1152px, calc(100vw - 48px)";
const loading = eager ? "eager" : "lazy";
---

<figure class:list={["window", className]}>
  <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
  <Picture
    class="shot"
    pictureAttributes={{ class: "light" }}
    src={light}
    alt={alt}
    formats={["avif", "webp"]}
    widths={[640, 1280, 2560]}
    sizes={sizes}
    loading={loading}
  />
  <Picture
    class="shot"
    pictureAttributes={{ class: "dark" }}
    src={dark}
    alt={alt}
    formats={["avif", "webp"]}
    widths={[640, 1280, 2560]}
    sizes={sizes}
    loading={loading}
  />
</figure>

<style>
  .window {
    position: relative;
    margin: 0;
    overflow: hidden;
    container-type: inline-size;
    border-radius: 12px;
    background: var(--vectis-surface);
    box-shadow:
      0 0 0 0.5px light-dark(oklch(23% 0.006 78 / 22%), oklch(100% 0 0 / 14%)),
      0 1px 2px light-dark(oklch(23% 0.006 78 / 6%), oklch(0% 0 0 / 30%)),
      0 30px 80px -24px light-dark(oklch(35% 0.04 50 / 30%), oklch(0% 0 0 / 60%));
  }
  .lights {
    position: absolute;
    top: 1.33cqw;
    left: 1.25cqw;
    z-index: 1;
    display: flex;
    gap: 0.625cqw;
  }
  .lights i {
    width: 0.94cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px oklch(0% 0 0 / 18%);
  }
  .lights i:nth-child(1) {
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .window :global(.shot) {
    display: block;
    width: 100%;
    height: auto;
  }
  .window :global(picture.dark),
  :global(:root[data-theme="dark"]) .window :global(picture.light) {
    display: none;
  }
  :global(:root[data-theme="dark"]) .window :global(picture.dark) {
    display: block;
  }
</style>
