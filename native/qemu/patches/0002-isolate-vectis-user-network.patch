                           const char *vhost6,
@@ -442,6 +451,17 @@
                           const char *tftp_server_name,
                           Error **errp)
 {
+#if defined(_WIN32) || !SLIRP_CHECK_VERSION(4, 7, 0)
+    if (vectis_isolate) {
+        error_setg(errp, "Vectis isolation requires a POSIX host and libslirp 4.7+");
+        return -1;
+    }
+#endif
+    if (vectis_isolate && (ipv6 || vnetwork || vhost || vnameserver ||
+                          vdhcp_start || tftp_export || smb_export)) {
+        error_setg(errp, "Vectis isolation requires default IPv4 networking without file exports");
+        return -1;
+    }
     /* default settings according to historic slirp */
     struct in_addr net  = { .s_addr = htonl(0x0a000200) }; /* 10.0.2.0 */
     struct in_addr mask = { .s_addr = htonl(0xffffff00) }; /* 255.255.255.0 */
@@ -645,6 +665,10 @@
     cfg.version =
          SLIRP_CHECK_VERSION(4, 9, 0) ? 6 :
          SLIRP_CHECK_VERSION(4, 7, 0) ? 4 : 1;
+    s->vectis_isolate = vectis_isolate;
+#if SLIRP_CHECK_VERSION(4, 7, 0)
+    cfg.disable_host_loopback = vectis_isolate;
+#endif
     cfg.restricted = restricted;
     cfg.in_enabled = ipv4;
     cfg.vnetwork = net;
@@ -1281,6 +1305,10 @@
