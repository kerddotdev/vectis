--- /dev/null
+++ b/net/vectis-isolation.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef VECTIS_ISOLATION_H
+#define VECTIS_ISOLATION_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <ifaddrs.h>
+#include <netinet/in.h>
+
+static bool vectis_local_address(uint32_t address)
+{
+    struct ifaddrs *interfaces, *item;
+    bool local = false;
+    if (getifaddrs(&interfaces) != 0) {
+        return true;
+    }
+    for (item = interfaces; item; item = item->ifa_next) {
+        if (item->ifa_addr && item->ifa_addr->sa_family == AF_INET &&
+            ntohl(((struct sockaddr_in *)item->ifa_addr)->sin_addr.s_addr) == address) {
+            local = true;
+            break;
+        }
+    }
+    freeifaddrs(interfaces);
+    return local;
+}
+
+static uint16_t vectis_u16(const uint8_t *p)
+{
+    return ((uint16_t)p[0] << 8) | p[1];
+}
+
+static bool vectis_public_address(uint32_t address)
+{
+    return (address >> 24) != 0 && (address >> 24) != 10 &&
+        (address >> 22) != 0x191 && (address >> 24) != 127 &&
+        (address >> 16) != 0xa9fe && (address >> 20) != 0xac1 &&
+        (address >> 16) != 0xc0a8 && (address >> 8) != 0xc00000 &&
+        (address >> 17) != 0x6309 && (address >> 24) < 224;
+}
+
+static bool vectis_packet_allowed(const uint8_t *frame, size_t size)
+{
+    const uint8_t *ip, *transport;
+    size_t header, length;
+    uint32_t destination;
+    uint16_t fragment, source_port = 0, destination_port = 0;
+    if (size < 14) {
+        return false;
+    }
+    if (vectis_u16(frame + 12) == 0x0806) {
+        return true;
+    }
+    /* Vectis uses IPv4 slirp. VLANs, IPv6 and other protocols fail closed. */
+    if (vectis_u16(frame + 12) != 0x0800 || size < 34) {
+        return false;
+    }
+    ip = frame + 14;
+    header = (ip[0] & 15) * 4;
+    length = vectis_u16(ip + 2);
+    if ((ip[0] >> 4) != 4 || header < 20 || length < header ||
+        length > size - 14) {
+        return false;
+    }
+    destination = ((uint32_t)ip[16] << 24) | ((uint32_t)ip[17] << 16) |
+        ((uint32_t)ip[18] << 8) | ip[19];
+    fragment = vectis_u16(ip + 6) & 0x3fff;
+    transport = ip + header;
+    if (!fragment && length >= header + 8 && (ip[9] == 6 || ip[9] == 17)) {
+        source_port = vectis_u16(transport);
+        destination_port = vectis_u16(transport + 2);
+        /* Only the virtual DNS resolver and DHCP server get private traffic. */
+        if (destination == 0x0a000203 && destination_port == 53) {
+            return true;
+        }
+        if ((destination == 0xffffffff || destination == 0x0a000202) &&
+            ip[9] == 17 && source_port == 68 && destination_port == 67) {
+            return true;
+        }
+        /* Replies to the owned SSH hostfwd use an accepted socket. Initial
+         * guest SYNs never qualify; libslirp also disables host loopback. */
+        if (destination == 0x0a000202 && ip[9] == 6 && source_port == 22 &&
+            length >= header + 20 && (transport[13] & 0x10)) {
+            return true;
+        }
+    }
+    return vectis_public_address(destination) && !vectis_local_address(destination);
+}
+#endif
