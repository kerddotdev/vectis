From: Vectis maintainers
Subject: [PATCH] net: isolate Vectis guests from host and private destinations

--- a/net/slirp.c
+++ b/net/slirp.c
@@ -25,6 +25,9 @@
 #include "qemu/osdep.h"
 #include "qemu/log.h"
 #include "net/slirp.h"
