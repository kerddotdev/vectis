---
import { site, themeStorageKey } from "../site";
import Logo from "./Logo.astro";

interface Props {
  current?: string;
}
const { current } = Astro.props;
const toggleScript = `document.addEventListener("click", (event) => {
  if (!(event.target instanceof Element) || !event.target.closest("[data-vectis-theme-toggle]")) return;
  const root = document.documentElement;
  const next = root.dataset.theme === "dark" ? "light" : "dark";
  root.dataset.theme = next;
  localStorage.setItem(${JSON.stringify(themeStorageKey)}, next);
});
const closeMenu = (menu) => {
  if (!menu.open || menu.classList.contains("closing")) return;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return void (menu.open = false);
  menu.classList.add("closing");
  menu.querySelector("nav").addEventListener("animationend", () => {
    menu.classList.remove("closing");
    menu.open = false;
  }, { once: true });
};
document.addEventListener("click", (event) => {
  const target = event.target instanceof Element ? event.target : null;
  for (const menu of document.querySelectorAll("details.menu[open]")) {
    if (target && menu.querySelector("summary").contains(target)) {
      event.preventDefault();
      closeMenu(menu);
    } else if (!target || !menu.contains(target)) closeMenu(menu);
  }
});
document.addEventListener("keydown", (event) => {
  if (event.key === "Escape") document.querySelectorAll("details.menu[open]").forEach(closeMenu);
});`;
---

<header class="site-header" data-blume-header>
  <div class="inner">
    <slot name="leading" />
    <a class="brand" href="/" aria-label="Vectis home">
      <Logo size={22} />
      <span>Vectis</span>
    </a>
    <nav class="links" aria-label="Primary">
      {
        site.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="controls">
      <slot />
      <a class="icon" href={site.repository} aria-label="Vectis on GitHub" data-tooltip="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>
      <button
        class="icon"
        type="button"
        data-vectis-theme-toggle
        aria-label="Switch color theme"
        data-tooltip="Switch theme"
      >
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
          ></path>
        </svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <a class="download" href={site.download}>Download</a>
      <details class="menu">
        <summary aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 8h16M4 16h16"></path>
          </svg>
        </summary>
        <nav aria-label="Primary">
          {
            site.navigation.map((item) => (
              <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={site.repository}>GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script is:inline set:html={toggleScript} />

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 64px;
    border-bottom: 1px solid var(--vectis-hairline);
    font-family: var(--vectis-font-sans);
    color: var(--vectis-foreground);
  }
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in oklch, var(--vectis-background) 86%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: inherit;
    text-decoration: none;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .links {
    display: flex;
    gap: 22px;
    margin-right: auto;
  }
  .links a,
  .menu nav a {
    color: var(--vectis-muted);
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    transition: color 120ms var(--vectis-ease-out, ease-out);
  }
  .links a:hover,
  .links a[aria-current="page"],
  .menu nav a:hover {
    color: var(--vectis-foreground);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .icon,
  .menu summary {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--vectis-muted);
    cursor: pointer;
    transition:
      color 120ms,
      background 120ms;
  }
  .icon {
    position: relative;
  }
  .icon[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--vectis-foreground);
    color: var(--vectis-background);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -2px) scale(0.96);
    transition:
      opacity 120ms var(--vectis-ease-out, ease-out),
      transform 120ms var(--vectis-ease-out, ease-out);
  }
  .icon[data-tooltip]:is(:hover, :focus-visible)::after {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    transition-delay: 400ms;
  }
  .icon:hover,
  .menu summary:hover {
    color: var(--vectis-foreground);
    background: var(--vectis-hairline);
  }
  .icon svg,
  .menu svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .icon svg[fill="currentColor"] {
    fill: currentColor;
    stroke: none;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }
  .download {
    margin-left: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--vectis-brand-fill);
    color: var(--vectis-on-brand);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: filter 120ms;
  }
  .download:hover {
    filter: brightness(1.06);
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu nav {
    position: absolute;
    right: 0;
    top: 44px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 200px;
    padding: 6px;
    border-radius: 16px;
    background: color-mix(in oklch, var(--vectis-raised) 88%, transparent);
    backdrop-filter: blur(28px) saturate(170%);
    box-shadow:
      inset 0 0 0 1px var(--vectis-hairline-strong),
      var(--vectis-shadow-lg);
  }
  .menu[open] nav {
    transform-origin: top right;
    animation: menu-in 160ms var(--vectis-ease-out, ease-out);
  }
  .menu.closing nav {
    animation: menu-out 120ms ease-in forwards;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
  }
  @keyframes menu-out {
    to {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
  }
  .menu nav a {
    padding: 8px 10px;
    border-radius: 10px;
  }
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--vectis-brand);
    outline-offset: 2px;
    border-radius: 10px;
  }
  @media (max-width: 760px) {
    .inner {
      gap: 12px;
      padding: 0 16px;
    }
    .links {
      display: none;
    }
    .controls {
      margin-left: auto;
    }
    .menu {
      display: block;
    }
  }
</style>
